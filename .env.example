# Backend Server Port
PORT=5000

# MongoDB Atlas Connection String (replace credentials & cluster host)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/booking_scheduler?retryWrites=true&w=majority

# Allowed CORS origin(s) - comma-separated if multiple
CORS_ORIGIN=http://3.106.223.11

# Frontend API Base URL (defaults to /api behind Nginx reverse proxy)
VITE_API_BASE_URL=/api
